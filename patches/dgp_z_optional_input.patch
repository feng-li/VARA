+def draw_Z_paper(key, p, q):
+    """
+    Draw Z according to the paper design:
+        Z_k ~ N(0, Sigma_z),  Sigma_z[j1,j2] = 0.5^{|j1-j2|}
+    """
+    idx = jnp.arange(q)
+    Sigma_z = 0.5 ** jnp.abs(idx[:, None] - idx[None, :])
+    Z = multivariate_normal(key, jnp.zeros(q), Sigma_z, (p,))
+    return Z


